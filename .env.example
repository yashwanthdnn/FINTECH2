# Database
DB_PATH=data/loan_prescreening.db

# Storage & Upload Limits
MAX_FILE_SIZE_MB=10

# Financial Defaults
DEFAULT_ANNUAL_INTEREST_RATE=12.0
MAX_PERMITTED_DTI=0.55
HIGH_RISK_DTI_THRESHOLD=0.50
MIN_MONTHLY_INCOME=15000.0
MIN_APPLICANT_AGE=18
MAX_APPLICANT_AGE=65

# Model Artifacts
MODEL_PATH=artifacts/credit_risk_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json

# Integration Sandboxes (true = Simulated mock mode, false = Live endpoints)
SIMULATED_KYC_MODE=true
SIMULATED_BUREAU_MODE=true
SIMULATED_BANKING_MODE=true
SIMULATED_DISBURSEMENT_MODE=true
